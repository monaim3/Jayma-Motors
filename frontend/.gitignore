# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# 3D model source (11 MB). Re-download from Khronos glTF-Sample-Assets (Models/CarConcept/glTF-Binary)
# into assets-src/models/, then run `node scripts/optimize-car.mjs` to rebuild public/models/car.glb.
/assets-src/models/*.glb

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Original camera videos (huge); the web versions live in public/videos/.
/assets-src/video/

# Generated by scripts/copy-map-worker.mjs on install
/public/vendor/
