# Public (sent to the browser) — never put secrets here
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server only
# Base URL the Next.js server uses to reach Laravel (same as NEXT_PUBLIC_API_URL unless an internal URL exists)
API_URL=http://localhost:8000
# Must match Laravel's SESSION_COOKIE
SESSION_COOKIE_NAME=jayma_session
# Shared with Laravel; protects POST /api/revalidate
REVALIDATE_SECRET=
