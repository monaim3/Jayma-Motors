# Public (sent to the browser) — never put secrets here
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Satellite 3D map on the home page (free key: cloud.maptiler.com). Restrict it to the site's
# domains in the MapTiler dashboard. Empty = colourful OpenStreetMap map, no key needed.
NEXT_PUBLIC_MAPTILER_KEY=
# Optional, with the MapTiler key: sharper Esri satellite photo (free key: location.arcgis.com,
# ArcGIS Location Platform; enable "Basemaps" for it and restrict referrers to the site's domains).
NEXT_PUBLIC_ARCGIS_KEY=

# Server only
# Base URL the Next.js server uses to reach Laravel (same as NEXT_PUBLIC_API_URL unless an internal URL exists)
API_URL=http://localhost:8000
# Must match Laravel's SESSION_COOKIE
SESSION_COOKIE_NAME=jayma_session
# Shared with Laravel; protects POST /api/revalidate
REVALIDATE_SECRET=
