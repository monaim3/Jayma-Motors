APP_NAME="Jayma Motors"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_BUSINESS_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB (same engine as Hostinger)
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jayma_motors
DB_USERNAME=jayma
DB_PASSWORD=

# Sanctum SPA cookie auth (Step 1 §7.1)
# Production: SESSION_DOMAIN=.jaymamotors.com, SESSION_SECURE_COOKIE=true,
# FRONTEND_URL=https://jaymamotors.com, SANCTUM_STATEFUL_DOMAINS=jaymamotors.com,www.jaymamotors.com
SESSION_DRIVER=database
# The frontend route guard checks for this cookie name (NEXT SESSION_COOKIE_NAME)
SESSION_COOKIE=jayma_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

FRONTEND_URL=http://localhost:3000
# Optional extra allowed CORS origins, comma-separated (defaults to FRONTEND_URL)
# FRONTEND_URLS=https://jaymamotors.com,https://www.jaymamotors.com
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
REVALIDATE_SECRET=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@jaymamotors.com"
MAIL_FROM_NAME="${APP_NAME}"

# First Super Admin (created by `php artisan db:seed`)
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
